# ============================================================
# TaskProof — Environment Variables
# ============================================================
# Copy this file to .env for local development.
# Never commit .env to version control.
# ============================================================

# ============================================================
# FRONTEND (Vite — prefix all with VITE_)
# ============================================================

# Local development: point directly at the FastAPI server
# VITE_API_URL=http://127.0.0.1:8000/api

# Production (Render Static Site + /api rewrite rule):
# VITE_API_URL=/api
#
# In production, Render rewrites /api/* → https://<backend>.onrender.com/api/*
# so the frontend uses relative /api URLs — no hardcoded backend hostname needed.

# ============================================================
# BACKEND (FastAPI — set these in Render Web Service environment)
# ============================================================

# Render injects $PORT automatically — do NOT set PORT yourself on Render.
# Locally you can run: uvicorn app.main:app --port 8000

# Space-separated list of allowed CORS origins.
# LOCAL: leave unset — defaults to localhost:5173 + 127.0.0.1:5173
# PRODUCTION: set to your Render static site URL, e.g.:
# ALLOWED_ORIGINS=https://taskproof.onrender.com
# ALLOWED_ORIGINS=http://localhost:5173 http://127.0.0.1:5173

# Optional: override the SQLite database file path.
# Default: backend/taskproof.db (relative to the running backend process)
# DATABASE_URL=sqlite:////data/taskproof.db
